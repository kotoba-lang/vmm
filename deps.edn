;; vmm — decision cores for a virtual machine monitor.
;;
;; The runtime dependency is the KIR interpreter, not the compiler: what ships
;; is the precompiled `resources/vmm/oracle/*.kir.edn`, and `kotoba.kir`
;; executes it. Amu is :test-only -- it is needed to REGENERATE the artifacts
;; and to prove the shipped ones still match their source, never to run them.
{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/osaho.git"
         :git/sha "6d08e3cffa09c003f8dbcdfaee964c4a1ea021ad"}}
 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                ;; Hosted in the amu repository; the coordinate keeps its
                ;; historical symbol so tools.deps dedupes it with every other
                ;; consumer in this workspace.
                io.github.kotoba-lang/compiler
                {:git/url "https://github.com/kotoba-lang/amu.git"
                 :git/sha "1e21a1f56613d7d4c7628af1945ebf1cf7862ff3"}}
   :main-opts ["-m" "cognitect.test-runner"]}

  ;; Regenerate resources/vmm/oracle/*.kir.edn from kotoba/*_core.kotoba:
  ;;   clojure -M:test:gen
  ;; (a later alias's :main-opts wins; command-line -m would be appended to
  ;; the test runner's instead of replacing it)
  :gen {:main-opts ["-m" "vmm.oracle-gen"]}}}
